# secretarIA-frontend — public build-time configuration.
#
# IMPORTANT: this file documents the two variables the app reads; it is NOT how
# they get set in production. Because the app is a Next.js STATIC EXPORT served by
# nginx, NEXT_PUBLIC_* values are baked into the bundle at `npm run build` time by
# the ARG/ENV pairs in the Dockerfile. Setting them only in EasyPanel's Environment
# panel has no effect on the built assets.
#
# Local development: copy to `.env.local` and adjust.

# brain-api base origin — identity, billing and signup live here.
# Scheme + host only, no trailing slash.
NEXT_PUBLIC_MANAGE_API_BASE_URL=https://secretaria-brain-api.cpux9k.easypanel.host

# secretarIA hub base origin — agenda and clinic configuration live here.
# Must be the service's PUBLIC origin (the browser calls it directly), not
# brain-api's internal SECRETARIA_BASE_URL. Scheme + host only, no trailing slash.
# Leave empty to force the honest "not configured" banner and demo data.
NEXT_PUBLIC_SECRETARIA_HUB_BASE_URL=https://secretaria-secretaria-api.cpux9k.easypanel.host
